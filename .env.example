# 复制为 .env 后填写。worker 启动时自动读取本文件（已存在的环境变量优先）。
# 以下均为示例值，请替换为你自己的环境。

OEM_CRAWL_DB_NAME=oem_crawl_test

OEM_CRAWL_DB_HOST=db.example.com
OEM_CRAWL_DB_PORT=3306
OEM_CRAWL_DB_USER=oem_crawl_user
OEM_CRAWL_DB_PASSWORD=change-me

# 抓取产物目录（html / shots），不存在会自动创建
OEM_CRAWL_OUTPUT_DIR=/path/to/oem-crawler/storage

# 心跳超过多少分钟视为 worker 已死，任务可被回收重跑
OEM_CRAWL_STALE_MINUTES=10

# 是否采集站点级事实（域名 / TLS / DNS / robots / sitemap / 安全头 / Wayback）。
# 默认 1；如服务器无法访问 RDAP / Archive / DoH，可设 0 关闭。
OEM_CRAWL_SITE_FACTS=1

# Playwright 浏览器安装目录（可选）。
# PLAYWRIGHT_BROWSERS_PATH=/path/to/oem-crawler/ms-playwright

# 可选：抓取出口代理（用于更换出口 IP）。
# 支持 http://user:pass@host:port 或 socks5://user:pass@host:port；留空则直连。
# OEM_CRAWL_PROXY=
